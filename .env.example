# PostgreSQL Database Configuration
POSTGRES_DB=microwatch
POSTGRES_USER=microwatch
POSTGRES_PASSWORD=microwatch
POSTGRES_PORT=5432

# Microservices URLs (Docker internal network resolution)
REGISTRY_URL=http://registry-service:8082
MONITORING_URL=http://monitoring-service:8081
NOTIFICATION_URL=http://notification-service:8084
API_GATEWAY_URL=http://api-gateway:8080

# Monitoring Configuration
MONITORING_INTERVAL_MS=10000

# Web Dashboard Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws/monitoring

# Android Client API Configuration
ANDROID_API_BASE_URL=http://10.0.2.2:8080
